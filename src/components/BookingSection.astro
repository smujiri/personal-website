---
import { type Lang, useTranslations } from '../i18n/index';
import BookingEmbed from './BookingEmbed.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="booking" class="py-28 bg-cream-light border-t border-cream-dark">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Centred column: header + enquiry form -->
    <div class="max-w-2xl mx-auto mb-16">

      <!-- Section header -->
      <div class="mb-12 pb-8 border-b border-cream-dark">
        <p class="label mb-3">{t('nav.book')}</p>
        <h2 class="font-display font-black text-charcoal uppercase text-4xl sm:text-5xl leading-none tracking-tight">
          {t('booking.title')}
        </h2>
      </div>
      <p class="font-display text-xs font-semibold uppercase tracking-widest text-charcoal/40 mb-8">
        Send an enquiry
      </p>

      <form id="contact-form" class="space-y-5" novalidate>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="cf-name" class="block font-display text-xs uppercase tracking-widest text-charcoal/50 mb-2">
              Full Name <span class="text-charcoal/30">*</span>
            </label>
            <input
              id="cf-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Jane Smith"
              class="w-full bg-white border border-cream-dark focus:border-charcoal/30 font-display text-sm text-charcoal placeholder-charcoal/20 px-4 py-3 outline-none transition-colors"
            />
          </div>
          <div>
            <label for="cf-email" class="block font-display text-xs uppercase tracking-widest text-charcoal/50 mb-2">
              Email Address <span class="text-charcoal/30">*</span>
            </label>
            <input
              id="cf-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full bg-white border border-cream-dark focus:border-charcoal/30 font-display text-sm text-charcoal placeholder-charcoal/20 px-4 py-3 outline-none transition-colors"
            />
          </div>
        </div>

        <div>
          <label for="cf-company" class="block font-display text-xs uppercase tracking-widest text-charcoal/50 mb-2">
            Company
          </label>
          <input
            id="cf-company"
            name="company"
            type="text"
            autocomplete="organization"
            placeholder="Acme Corp"
            class="w-full bg-white border border-cream-dark focus:border-charcoal/30 font-display text-sm text-charcoal placeholder-charcoal/20 px-4 py-3 outline-none transition-colors"
          />
        </div>

        <div>
          <label for="cf-subject" class="block font-display text-xs uppercase tracking-widest text-charcoal/50 mb-2">
            Subject <span class="text-charcoal/30">*</span>
          </label>
          <input
            id="cf-subject"
            name="subject"
            type="text"
            required
            placeholder="e.g. Trademark registration in Georgia"
            class="w-full bg-white border border-cream-dark focus:border-charcoal/30 font-display text-sm text-charcoal placeholder-charcoal/20 px-4 py-3 outline-none transition-colors"
          />
        </div>

        <div>
          <label for="cf-message" class="block font-display text-xs uppercase tracking-widest text-charcoal/50 mb-2">
            Message <span class="text-charcoal/30">*</span>
          </label>
          <textarea
            id="cf-message"
            name="message"
            required
            rows="5"
            placeholder="Briefly describe how we can help you..."
            class="w-full bg-white border border-cream-dark focus:border-charcoal/30 font-display text-sm text-charcoal placeholder-charcoal/20 px-4 py-3 outline-none transition-colors resize-none"
          ></textarea>
        </div>

        <div class="flex items-center gap-5 pt-1">
          <button
            type="submit"
            id="cf-submit"
            class="inline-flex items-center gap-3 bg-charcoal text-cream font-display font-bold text-xs uppercase tracking-widest px-8 py-4 hover:bg-charcoal-light transition-colors duration-200"
          >
            Send Message
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
          <p id="cf-status" class="font-display text-xs tracking-wide hidden"></p>
        </div>
      </form>
    </div><!-- end centred column -->

    <!-- Divider -->
    <div class="flex items-center gap-6 mb-16">
      <div class="flex-1 h-px bg-cream-dark"></div>
      <p class="font-display text-xs font-semibold uppercase tracking-widest text-charcoal/30 shrink-0">
        Or book a call directly
      </p>
      <div class="flex-1 h-px bg-cream-dark"></div>
    </div>

    <!-- Cal.com embed -->
    <div class="max-w-3xl mx-auto w-full border border-cream-dark overflow-hidden bg-white">
      <BookingEmbed client:load calLink="mujiri" calOrigin="https://cal.eu" />
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
  const status = document.getElementById('cf-status') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.classList.add('hidden');

    const data = {
      name: (form.elements.namedItem('name') as HTMLInputElement).value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
      company: (form.elements.namedItem('company') as HTMLInputElement).value.trim(),
      subject: (form.elements.namedItem('subject') as HTMLInputElement).value.trim(),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim(),
    };

    if (!data.name || !data.email || !data.subject || !data.message) {
      status.textContent = 'Please fill in all required fields.';
      status.className = 'font-display text-xs tracking-wide text-red-500/70';
      status.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.reset();
        status.textContent = 'Message sent — we\'ll be in touch shortly.';
        status.className = 'font-display text-xs tracking-wide text-charcoal/50';
      } else {
        status.textContent = 'Something went wrong. Please email us directly at info@mujiri.ge';
        status.className = 'font-display text-xs tracking-wide text-red-500/70';
      }
    } catch {
      status.textContent = 'Could not send — please email us at info@mujiri.ge';
      status.className = 'font-display text-xs tracking-wide text-red-500/70';
    } finally {
      status.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = `Send Message <svg class="w-4 h-4 inline ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>`;
    }
  });
</script>
