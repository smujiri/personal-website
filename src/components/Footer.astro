---
import { type Lang, useTranslations } from '../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = `/${lang}`;

const year = new Date().getFullYear();

const navLinks = [
  { href: `${base}/#services`, label: t('nav.services') },
  { href: `${base}/#about`, label: t('nav.about') },
  { href: `${base}/#booking`, label: t('nav.book') },
];

const contact = [
  { key: 'L.', value: 'Zurab Avalishvili 13, Block B, 0179 Tbilisi, Georgia' },
  { key: 'E.', value: 'info@mujiri.ge' },
  { key: 'W.', value: 'www.mujiri.ge' },
  { key: 'T.', value: '+995 555 955550' },
];
---

<footer class="text-cream" style="background-color: #757b81;">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Main footer -->
    <div class="py-16 grid grid-cols-1 md:grid-cols-3 gap-14 border-b border-white/10">

      <!-- Brand -->
      <div>
        <a href={base} class="font-display font-bold text-white text-lg tracking-tight inline-block mb-4">
          MUJIRI <span class="font-light text-white/40">IP</span>
        </a>
        <p class="font-display text-white/30 text-xs uppercase tracking-widest leading-relaxed">
          {t('footer.tagline')}
        </p>

        <div class="flex gap-3 mt-8">
          <a
            href="https://www.linkedin.com/in/sophio-mujiri/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-9 h-9 border border-white/15 text-white/40 hover:text-white hover:border-white/40 flex items-center justify-center transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://wa.me/995555955550"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-9 h-9 border border-white/15 text-white/40 hover:text-white hover:border-white/40 flex items-center justify-center transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <p class="font-display text-xs font-semibold uppercase tracking-widest text-white/30 mb-6">
          {t('footer.nav.title')}
        </p>
        <ul class="space-y-3">
          {navLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="font-display text-xs font-semibold uppercase tracking-widest text-white/50 hover:text-white transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="font-display text-xs font-semibold uppercase tracking-widest text-white/30 mb-6">
          Contact
        </p>
        <ul class="space-y-4">
          {contact.map(({ key, value }) => (
            <li class="flex items-start gap-4">
              <span class="font-display font-bold text-white/30 text-xs w-6 shrink-0 pt-0.5">{key}</span>
              {key === 'T.' ? (
                <a
                  href="https://wa.me/995555955550"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-display text-white/60 text-xs leading-relaxed hover:text-white transition-colors"
                >{value}</a>
              ) : (
                <span class="font-display text-white/60 text-xs leading-relaxed">{value}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="py-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-white/25 text-xs font-display uppercase tracking-widest">
      <span>&copy; {year} Mujiri IP. {t('footer.rights')}</span>
      <span class="flex gap-6">
        <a href={`${base}/privacy`} class="hover:text-white/50 transition-colors">{t('footer.privacy')}</a>
        <a href={`${base}/terms`} class="hover:text-white/50 transition-colors">{t('footer.terms')}</a>
      </span>
    </div>
  </div>
</footer>
